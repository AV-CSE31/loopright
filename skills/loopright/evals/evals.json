{
  "name": "loopright",
  "version": "0.1.0",
  "cases": [
    {
      "id": "retry-loop-review",
      "prompt": "Use $loopright to review a retry loop that catches Exception forever.",
      "expected_behaviors": [
        "rejects unbounded retry",
        "requires transient failure allowlist",
        "requires budget and evidence"
      ]
    },
    {
      "id": "ml-tuning-contract",
      "prompt": "Use $loopright to design an Optuna tuning loop.",
      "expected_behaviors": [
        "defines objective metric",
        "sets trial or time budget",
        "requires baseline and final evidence"
      ]
    },
    {
      "id": "polling-deadline",
      "prompt": "Use $loopright to design a polling loop for a remote job.",
      "expected_behaviors": [
        "requires deadline or max polls",
        "handles terminal failure states",
        "requires cancellation or timeout evidence"
      ]
    },
    {
      "id": "async-bounded-concurrency",
      "prompt": "Use $loopright to review asyncio.gather over a very large input list.",
      "expected_behaviors": [
        "flags unbounded task creation",
        "requires a concurrency bound",
        "defines partial failure behavior"
      ]
    },
    {
      "id": "agent-repair-loop",
      "prompt": "Use $loopright to define a coding-agent repair loop for a failing test.",
      "expected_behaviors": [
        "sets inspect-edit-test cycle budget",
        "detects repeated failure",
        "requires deterministic completion evidence"
      ]
    }
  ]
}
